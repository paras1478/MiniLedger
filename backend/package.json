{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "MiniLedger REST API (Express, TypeScript, PostgreSQL, Prisma)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --include .env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "tsx src/scripts/check-db.ts",
    "db:studio": "prisma studio",
    "twilio:check": "tsx src/scripts/twilio-check.ts",
    "pretest": "tsx tests/prepare-db.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
