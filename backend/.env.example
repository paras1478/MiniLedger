# Copy this file to `.env` and fill in real values. `.env` is gitignored, so never commit it.

# Server
NODE_ENV=development
PORT=4100
# Comma-separated list of origins allowed by CORS. Leave empty to allow all (development only).
CORS_ORIGIN=

# PostgreSQL connection string used by Prisma (CLI and runtime).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If your local server uses passwordless (trust) auth, omit ":PASSWORD".
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/miniledger?schema=public
# Separate database for `npm test` (created and migrated automatically; its tables are emptied
# between tests). The name must end in "_test".
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/miniledger_test?schema=public

# Auth secrets: long random strings, different from each other. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs login JWTs. Changing it logs everyone out.
JWT_SECRET=
# How long a login token is valid (s/m/h/d/w).
JWT_EXPIRES_IN=7d
# Key for hashing OTP codes before they are stored (HMAC-SHA256).
OTP_SECRET=

# Timezone that defines "today": a PENDING loan is overdue once its due date is before today here.
APP_TIMEZONE=Asia/Kolkata

# One-time login/verification codes.
# OTP_PROVIDER: "console" (codes are printed to this server's log; development only, refused when
# NODE_ENV=production) or "twilio" (Twilio Verify sends and checks codes by SMS).
# Leave empty for the default: console in development, Twilio in production.
OTP_PROVIDER=
# Twilio credentials: Console > Account info. Server-side only; never put them in mobile/.env.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Authenticate with EITHER an API key + secret (recommended: Console > Account > API keys)...
TWILIO_API_KEY=
TWILIO_API_SECRET=
# ...OR the account Auth Token.
TWILIO_AUTH_TOKEN=
# Console > Verify > Services > your service > Service SID: "VA" + 32 hex characters.
# Check the whole setup (read-only) with: npm run twilio:check --workspace backend
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Minimum seconds between two codes to the same number, and codes per number per hour.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
