# Copy this file to `.env`. Restart `npx expo start` after changing it.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone, so never put secrets here.

# Base URL of the MiniLedger API.
#   Web / iOS simulator:  http://localhost:4100
#   Android emulator:     http://10.0.2.2:4100
#   Physical phone:       http://<your-PC-LAN-IP>:4100  (find it with `ipconfig`)
EXPO_PUBLIC_API_URL=http://localhost:4100
